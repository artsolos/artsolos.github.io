---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import ContactLinks from '../components/ContactLinks.astro';
import KineticText from '../components/KineticText.astro';
import { profile } from '../data/profile';
import { selectedSlugs } from '../data/organization';
import { getProjects, href } from '../lib/site';
const projects=await getProjects();
const selected=selectedSlugs.map(id=>projects.find(p=>p.id===id)!);
---
<BaseLayout description={`${profile.name}, Computer Engineering student at Northeastern University with a Business Administration minor. Embedded software, FPGA logic and physical prototypes.`}>
<section class="container home-intro"><div class="intro-kicker" data-entrance-load><span>{profile.identity}</span><span>{profile.school}</span><span>{profile.education.minor} minor</span></div><h1 class="home-name"><span class="name-entrance" data-entrance-load><KineticText text="Arefin"/><KineticText text="Mahmood" align="end"/></span></h1><div class="intro-copy"><p data-entrance-load>{profile.intro}</p><a class="btn" data-entrance-load href={href('work/')}>Explore the work ↗</a></div></section>
<section class="container selected-section" id="work" aria-labelledby="selected-title"><div class="editorial-section-head"><h2 class="eyebrow" id="selected-title">Selected engineering work (03)</h2><a href={href('work/')}>All work (25) ↗</a></div><div class="selected-projects">{selected.map((p,i)=><ProjectPreview project={p} index={i} selected eager={i===0}/>)}</div></section>
<section class="container home-about" id="about" aria-labelledby="about-title"><h2 class="eyebrow" id="about-title">A bit about me</h2><div><p>I'm a computer engineering student at Northeastern University, with a minor in Business Administration.</p><div class="inline-links"><a href={href('about/')}>More about me ↗</a><a href={href('coursework/')}>Browse coursework ↗</a></div></div></section>
<section class="container contact-section" id="contact" aria-labelledby="contact-title"><p class="eyebrow">Co-op, internships, or a conversation about the work</p><h2 id="contact-title"><a class="contact-callout" href={href('contact/')} aria-label="Get in touch — send a message"><KineticText text="Get in touch ↗" radius={360}/></a></h2><p>I'm happy to talk about co-op and internship roles, or about any of the projects here. Email is the best way to reach me.</p><ContactLinks /></section>
</BaseLayout>
<style>.contact-callout{display:block;color:var(--text);text-decoration:none;border-bottom:1px solid var(--control);padding-block:10px;transition:color 300ms ease}.contact-callout:is(:hover,:focus-visible){color:var(--motion-accent);border-color:currentColor}.contact-callout:focus-visible{outline:2px solid var(--accent);outline-offset:6px}@media(max-width:40rem){.contact-callout{font-size:clamp(36px,9.5vw,48px)}}</style>
