---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout title="Contact" description="Send Arefin Mahmood a message about co-op and internship roles or his engineering work."><section class="container editorial-page contact-page"><p data-entrance-load class="eyebrow">Contact</p><h1 data-entrance-load class="display-title">Get in touch ↗</h1><ContactForm /></section></BaseLayout>
<style>.contact-page h1{margin-bottom:48px;font-size:clamp(56px,9vw,132px)}@media(max-width:40rem){.contact-page h1{margin-bottom:32px}}</style>
