---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../lib/site';
---
<BaseLayout title="Projects have moved to Work" description="The complete project collection is now on Work."><div class="container editorial-page"><h1>Explore all work</h1><p>The complete collection is now on the Work page, including engineering, coursework and business cases.</p><p>The EECE 2160 lab sequence is on <a href={href('coursework/embedded-design/#seq-title')}>Embedded Design</a>.</p><a class="btn" data-work-redirect href={href('work/')}>Open Work ↗</a></div></BaseLayout>
<script>
import {onPage} from '../../lib/page-lifecycle';
import {navigate} from 'astro:transitions/client';
onPage(() => {
const link=document.querySelector<HTMLAnchorElement>('[data-work-redirect]');
if(link){const target=new URL(location.hash==='#seq-title'?link.href.replace(/work\/$/,'coursework/embedded-design/'):link.href);target.search=location.search;target.hash=location.hash;link.href=target.href;void navigate(target.href,{history:'replace'});}
});
</script>
