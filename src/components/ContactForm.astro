---
import { profile } from '../data/profile';
const email=profile.personalEmail!;
const endpoint=`https://formsubmit.co/${email}`;
---
<form class="message-form" action={endpoint} method="POST" data-astro-reload data-contact-form data-endpoint={`https://formsubmit.co/ajax/${email}`}>
  <div class="form-fields">
    <div class="form-field"><label for="contact-name">Name</label><input id="contact-name" name="name" autocomplete="name" required maxlength="120" aria-describedby="contact-name-error"/><p class="field-error" id="contact-name-error" hidden></p></div>
    <div class="form-field"><label for="contact-email">Email address</label><input id="contact-email" type="email" name="email" autocomplete="email" inputmode="email" required maxlength="254" aria-describedby="contact-email-error"/><p class="field-error" id="contact-email-error" hidden></p></div>
    <div class="form-field"><label for="contact-message">Message</label><textarea id="contact-message" name="message" rows="6" required maxlength="10000" aria-describedby="contact-message-error"></textarea><p class="field-error" id="contact-message-error" hidden></p></div>
  </div>
  <div class="form-honeypot" aria-hidden="true"><label for="contact-website">Leave this field empty</label><input id="contact-website" type="text" name="_honey" tabindex="-1" autocomplete="off" /></div>
  <input type="hidden" name="_subject" value="New portfolio message — Arefin Mahmood" />
  <div class="send-row"><button class="btn send-message" type="submit">Send message <span aria-hidden="true">↗</span></button><p class="form-status" data-form-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p></div>
  <p class="email-fallback">Prefer email? <a href={`mailto:${email}`}>{email}</a></p>
</form>
<script>
  import { initContactForm } from '../scripts/contact-form';
  import {onPage} from '../lib/page-lifecycle';
  onPage(() => {
  const form=document.querySelector<HTMLFormElement>('[data-contact-form]');
  if(form)return initContactForm(form);
  });
</script>
<style>
 .message-form{max-width:760px;padding-top:12px}
 .form-fields{display:grid;gap:26px}.form-field{display:grid;gap:8px}
 label{font:12px/1.5 var(--font-mono);text-transform:uppercase;letter-spacing:.04em}
 input,textarea{width:100%;min-height:52px;border:1px solid var(--control);border-radius:0;background:transparent;color:var(--text);padding:14px 16px;font:inherit;line-height:1.5}
 textarea{resize:vertical;min-height:170px}input:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
 [aria-invalid=true]{border-color:#ffb7b7}.field-error{font-size:14px;color:#ffb7b7;margin:0;line-height:1.5}
 .form-honeypot{display:none}.send-row{display:flex;align-items:center;gap:24px;margin-top:26px}
 .send-message{flex-shrink:0;border-radius:40px;min-height:52px;padding:14px 26px;font:12px var(--font-mono);text-transform:uppercase;background:var(--accent);color:var(--bg);border:1px solid var(--accent)}
 .send-message:hover{background:var(--text);border-color:var(--text);color:var(--bg)}
 .send-message:disabled{cursor:wait;opacity:.7}.form-status{margin:0;font-size:15px;line-height:1.5;max-width:48ch}
 .form-status[data-state=error]{color:#ffb7b7}.form-status[data-state=success]{color:var(--accent)}
 .email-fallback{font-size:14px;margin-top:28px;color:var(--text-2)}.email-fallback a{overflow-wrap:anywhere}
 @media(max-width:40rem){.send-row{align-items:start;flex-direction:column;gap:18px}.message-form{padding-top:0}}
</style>
