---
const uid = 'tg' + Math.random().toString(36).slice(2, 8);
// Tripod gait and turning sign pattern, drawn from the Lab 9 report's code
// comments: TRIPOD1 = RF, LM, RB; TRIPOD2 = LF, RM, LB. A left turn strides the
// right side forward and the left side backward.
const legs = [
  { id: 'LF', x: 120, y: 70, t: 2, side: 'L' },
  { id: 'LM', x: 100, y: 150, t: 1, side: 'L' },
  { id: 'LB', x: 120, y: 230, t: 2, side: 'L' },
  { id: 'RF', x: 300, y: 70, t: 1, side: 'R' },
  { id: 'RM', x: 320, y: 150, t: 2, side: 'R' },
  { id: 'RB', x: 300, y: 230, t: 1, side: 'R' },
];
---

<svg class="diagram" viewBox="0 0 640 300" role="img" aria-labelledby={`${uid}-title ${uid}-desc`}>
  <title id={`${uid}-title`}>Tripod gait leg groups and left-turn stride directions</title>
  <desc id={`${uid}-desc`}>
    Top view of the six legs. Tripod 1 is right front, left middle, and right back. Tripod 2 is left front, right middle,
    and left back. One tripod lifts and swings while the other supports the body, then they swap. For a left turn, legs on
    the right side stride forward and legs on the left side stride backward.
  </desc>
  <rect class="body" x="160" y="60" width="100" height="180" rx="22" />
  <text x="210" y="155" class="body-lbl" text-anchor="middle">BODY</text>
  <text x="210" y="40" class="axis" text-anchor="middle">FRONT ↑</text>
  {
    legs.map((l) => {
      const ax = l.side === 'L' ? 160 : 260;
      return (
        <g class:list={['leg', `t${l.t}`]}>
          <path class="limb" d={`M${ax},${l.y} L${l.x},${l.y}`} />
          <circle cx={l.x} cy={l.y} r="16" />
          <text x={l.x} y={l.y + 4} text-anchor="middle" class="leg-lbl">
            {l.id}
          </text>
          <path
            class="arrow"
            d={l.side === 'R' ? `M${l.x + 28},${l.y + 10} L${l.x + 28},${l.y - 14}` : `M${l.x - 28},${l.y - 10} L${l.x - 28},${l.y + 14}`}
            marker-end={`url(#${uid}-arrow)`}
          />
        </g>
      );
    })
  }
  <defs>
    <marker id={`${uid}-arrow`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#a5b2c1"></path>
    </marker>
  </defs>
  <g class="key">
    <circle cx="420" cy="80" r="9" class="k1" />
    <text x="438" y="85">Tripod 1: RF · LM · RB</text>
    <circle cx="420" cy="115" r="9" class="k2" />
    <text x="438" y="120">Tripod 2: LF · RM · LB</text>
    <text x="410" y="170" class="axis">Arrows: stride direction</text>
    <text x="410" y="190" class="axis">for a left turn</text>
    <text x="410" y="225">Right side → forward</text>
    <text x="410" y="248">Left side → backward</text>
  </g>
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    background: var(--surface);
  }
  .body {
    fill: var(--raised);
    stroke: #4f6178;
  }
  .body-lbl,
  .axis {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    fill: var(--text-2);
  }
  .limb {
    stroke: #4f6178;
    stroke-width: 3;
  }
  .t1 circle,
  .k1 {
    fill: #17344a;
    stroke: var(--accent);
    stroke-width: 2;
  }
  .t2 circle,
  .k2 {
    fill: var(--raised);
    stroke: #a5b2c1;
    stroke-width: 2;
    stroke-dasharray: 4 3;
  }
  .leg-lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text);
  }
  .arrow {
    stroke: #a5b2c1;
    stroke-width: 1.6;
    fill: none;
  }
  .key text {
    font-family: var(--font-sans);
    font-size: 14px;
    fill: var(--text);
  }
  .key .axis {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--text-2);
  }
</style>
