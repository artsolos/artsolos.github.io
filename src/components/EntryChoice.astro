---
import { interfaceSound } from '../lib/interface-sound-settings';
const { choiceEvent, sessionKey } = interfaceSound;
---
<!-- First-visit Home sound choice. Shown only when the head bootstrap sets
     html[data-entry-choice]; without JavaScript or storage it never appears. -->
<div class="entry-choice" role="dialog" aria-modal="true" aria-labelledby="entry-choice-title" aria-describedby="entry-choice-text">
  <div class="entry-card" tabindex="-1">
    <p class="entry-eyebrow">Sound</p>
    <h2 id="entry-choice-title">Choose your sound</h2>
    <p id="entry-choice-text">Short click and page-transition sounds, off unless you turn them on. You can change this anytime from the Sound control.</p>
    <div class="entry-actions">
      <button type="button" data-entry="sound">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M3 7.75h3L10 4.5v11L6 12.25H3z" /><path d="M13 7.5c.9 1.2.9 3.8 0 5M15.4 5.5c1.9 2.4 1.9 6.6 0 9" /></svg>
        Enter with sound
      </button>
      <button type="button" data-entry="quiet">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M3 7.75h3L10 4.5v11L6 12.25H3z" /><path d="M13.25 8l4 4M17.25 8l-4 4" /></svg>
        Enter quietly
      </button>
    </div>
  </div>
</div>
<script is:inline define:vars={{ choiceEvent, sessionKey }}>
  (function () {
    var root = document.documentElement, el = document.querySelector('.entry-choice');
    if (!el || el.dataset.ready || !root.hasAttribute('data-entry-choice')) return;
    el.dataset.ready = 'true';
    var card = el.querySelector('.entry-card'), buttons = el.querySelectorAll('button');
    // Everything behind the choice is inert, so focus and screen readers stay inside it.
    var behind = Array.prototype.filter.call(document.body.children, function (n) { return n !== el && n.tagName !== 'SCRIPT'; });
    behind.forEach(function (n) { n.inert = true; });
    card.focus({ preventScroll: true });
    var close = function (withSound) {
      if (!root.hasAttribute('data-entry-choice')) return;
      // The sound module plays its acknowledgement inside this same gesture; it
      // cancels the event when it handled it. Otherwise keep the choice for its startup.
      var handled = !document.dispatchEvent(new CustomEvent(choiceEvent, { detail: { enabled: withSound }, cancelable: true }));
      if (!handled && withSound) { try { sessionStorage.setItem(sessionKey, 'true'); } catch (e) {} }
      behind.forEach(function (n) { n.inert = false; });
      el.classList.add('is-leaving');
      root.removeAttribute('data-entry-choice');
      var brand = document.querySelector('.site-header .brand');
      if (brand) brand.focus({ preventScroll: true });
      var done = function () { el.classList.remove('is-leaving'); el.hidden = true; };
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) done(); else setTimeout(done, 220);
    };
    el.addEventListener('click', function (e) {
      var b = e.target instanceof Element && e.target.closest('[data-entry]');
      if (b) close(b.getAttribute('data-entry') === 'sound');
    });
    el.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { e.preventDefault(); close(false); return; }
      if (e.key === 'Tab') {
        var first = buttons[0], last = buttons[buttons.length - 1], active = document.activeElement;
        if (e.shiftKey && (active === first || active === card)) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
        return;
      }
      if (!(e.target instanceof Element && e.target.closest('button')) && /^( |Arrow(Up|Down)|Page(Up|Down)|Home|End)$/.test(e.key)) e.preventDefault();
    });
    // Hold the page still beneath the choice without hiding the scrollbar (no layout shift).
    el.addEventListener('wheel', function (e) { e.preventDefault(); }, { passive: false });
    el.addEventListener('touchmove', function (e) { e.preventDefault(); }, { passive: false });
  })();
</script>
<style is:global>
  .entry-choice{display:none}
  html[data-entry-choice] .entry-choice,.entry-choice.is-leaving{position:fixed;inset:0;z-index:120;display:grid;place-items:center;padding:var(--gutter);background:rgb(11 15 20 / .86);overscroll-behavior:contain;touch-action:none}
  .entry-choice.is-leaving{pointer-events:none;animation:entry-out 200ms ease forwards}
  .entry-card{width:min(440px,100%);padding:26px 28px 28px;background:var(--surface);border:1px solid var(--divider);border-top-color:#3a4b5f;border-radius:var(--r-panel,10px);box-shadow:0 18px 40px rgb(0 0 0 / .36);animation:entry-in 240ms cubic-bezier(.22,.61,.36,1)}
  .entry-card:focus{outline:none}
  .entry-eyebrow{font:500 12px var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--text-2)}
  .entry-card h2{margin-top:14px;font-size:30px;font-weight:600;line-height:1.1;letter-spacing:-.02em}
  .entry-card h2+p{margin-top:12px;font-size:16px;line-height:1.55;color:var(--text-2);max-width:36ch}
  .entry-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:24px}
  .entry-actions button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 14px;background:transparent;border:1px solid var(--control);border-radius:var(--r-control,8px);color:var(--text);font:12px var(--font-mono);letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;cursor:pointer;transition:background-color 180ms ease,border-color 180ms ease}
  .entry-actions button:hover{background:var(--raised);border-color:var(--text-2)}
  .entry-actions button:active{background:var(--bg)}
  .entry-actions button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  @keyframes entry-in{from{opacity:0;transform:translateY(6px)}}
  @keyframes entry-out{to{opacity:0}}
  @media(max-width:30rem){.entry-actions{grid-template-columns:1fr}.entry-card{padding:22px 20px 20px}.entry-card h2{font-size:26px}}
  @media(prefers-reduced-motion:reduce){.entry-card,.entry-choice.is-leaving{animation:none}.entry-actions button{transition:none}}
  @media(forced-colors:active){.entry-card{border:1px solid CanvasText}}
</style>
