{
  "name": "arefin-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Engineering portfolio of Arefin Mahmood, built with Astro as a static site for GitHub Pages.",
  "scripts": {
    "dev": "node scripts/astro.mjs dev",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview",
    "check": "node scripts/astro.mjs check",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run check && npm run build && npm run check:links"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
